# HIL CI bench settings for Linux.
# Read by the watcher service (systemd EnvironmentFile), the GitHub Actions job and,
# for manual runs, by:   set -a; . ~/.config/hil-ci/hil-ci.env; set +a
# Format: KEY=VALUE, absolute paths, no quotes, no spaces around "=", no ~ or $HOME.

# Serial ports. Use the stable names in /dev/serial/by-id/ (find them with find_ports.sh):
# /dev/ttyACM0, 1, 2 change order when a device re-enumerates (the DUT does it on every power cycle).
HIL_PORT=/dev/serial/by-id/CHANGE_ME_HIL_board
HIL_DUT_PORT=/dev/serial/by-id/CHANGE_ME_DUT
HIL_LOG_PORT=/dev/serial/by-id/CHANGE_ME_Pico

# Tools
HIL_STM32_PROGRAMMER=@HOME@/STMicroelectronics/STM32Cube/STM32CubeProgrammer/bin/STM32_Programmer_CLI
HIL_CUBEIDE=/opt/st/stm32cubeide_1.19.0/stm32cubeide

# Data (clones of user repos, results, state) and the Python venv made by setup_linux.sh
HIL_CI_DATA=@HOME@/hil_ci_data
HIL_VENV=@HOME@/hil-venv
